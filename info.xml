<?xml version="1.0"?>
<extension key="com.joineryhq.financialreports" type="module">
  <file>financialreports</file>
  <name>Financial Reports</name>
  <description>Additional reports for financial annalysis</description>
  <license>GPL-3.0</license>
  <maintainer>
    <author>Allen Shaw</author>
    <email>allen@JoineryHQ.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://github.com/twomice/com.joinery.financialreports</url>
    <url desc="Documentation">https://github.com/twomice/com.joinery.financialreports</url>
    <url desc="Support">https://github.com/twomice/com.joinery.financialreports/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/gpl-3.0.html</url>
  </urls>
  <releaseDate>2017-02-05</releaseDate>
  <version>0.3</version>
  <develStage>alpha</develStage>
  <compatibility>
    <ver>5.51</ver>
  </compatibility>
  <comments>Initial development sponsored by Amiela.</comments>
  <civix>
    <namespace>CRM/Financialreports</namespace>
    <format>25.10.2</format>
  </civix>
  <mixins>
    <mixin>mgd-php@2.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>scan-classes@1.0.0</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
</extension>
